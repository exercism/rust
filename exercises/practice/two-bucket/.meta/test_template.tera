use two_bucket::*;

{% component bucket(label) -%}
    {% if label == 'one' -%}
        Bucket::One
    {%- else -%}
        Bucket::Two
    {%- endif %}
{%- endcomponent bucket -%}

{% for test in cases %}
#[test]
#[ignore]
fn {{ test.description | make_ident }}() {
    let output = solve(
        {{ test.input.bucketOne }}, {{ test.input.bucketTwo }}, {{ test.input.goal }},
        &{{<bucket label={test.input.startBucket} />}},
    );
    let expected = {% if 'error' in test.expected -%}
        None
    {%- else -%}
        Some(BucketStats {
            moves: {{ test.expected.moves }},
            goal_bucket: {{<bucket label={test.expected.goalBucket} />}},
            other_bucket: {{ test.expected.otherBucket }},
        })
    {%- endif %};
    assert_eq!(output, expected);
}
{% endfor -%}
